{
  "name": "ilenhr-hiring-exercise",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "db:seed": "node --import tsx scripts/seed.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test src/server/store.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
